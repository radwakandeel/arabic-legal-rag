# Required (name only, put your own key; never commit the real .env)
GEMINI_API_KEY=put_your_key_here

# Optional, Docker only: change the host port (default 8000)
# HOST_PORT=8001

# Optional: GEMINI_MODEL must be set in the SHELL, not in this file:
#   export GEMINI_MODEL=gemini-3.5-flash-lite
# (rag.py reads it before .env is loaded; default is gemini-3.5-flash-lite)

# DagsHub credentials are NOT environment variables. They go in .dvc/config.local
# (see README, section "Data and reproducibility (DVC)").
